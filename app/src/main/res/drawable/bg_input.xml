<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：浅灰填充；聚焦时出现主色描边，给出明确的光标位置反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_fill" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="@dimen/hairline" android:color="@color/separator" />
        </shape>
    </item>
</selector>
