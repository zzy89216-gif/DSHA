<?xml version="1.0" encoding="utf-8"?>
<!-- 可点胶囊（顶栏图标、横幅）：浅灰底 + 涟漪 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/raised" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
</ripple>
