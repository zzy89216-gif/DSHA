<?xml version="1.0" encoding="utf-8"?>
<!--
  启动页（苹果官网式）：居中大字状态 + 胶囊主按钮为视觉焦点；常用入口紧随其后；
  端口 / 环境 / 日志 / 安全启动 / 恢复选项收进「运行详情」折叠区（启动中或有异常时自动展开）。
  所有既有 ID 保持不变，业务代码无需感知布局层级变化。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/dshaPageBackground" android:id="@+id/launch_panel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="20dp" android:paddingBottom="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_sections" android:orientation="vertical">

                <!-- Hero -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_actions" android:orientation="vertical" android:gravity="center_horizontal" android:background="?attr/dshaCardBackground" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="28dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/launch_run_dot" android:text="●  DSHA" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:gravity="center" android:fontFamily="sans-serif-medium" android:letterSpacing="0.02"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_run_state" android:text="@string/ui2_stopped" android:textSize="30sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:letterSpacing="-0.02" android:gravity="center" android:layout_marginTop="12dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_subtitle" android:text="@string/ui2_launch_hint" android:textSize="16sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_status" android:visibility="gone" android:text="" android:textSize="13sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:gravity="center" android:lineSpacingExtra="2dp" android:layout_marginTop="10dp"/>
                    <ProgressBar android:layout_width="match_parent" android:layout_height="3dp" android:id="@+id/launch_busy" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:indeterminateTint="@color/primary" android:layout_marginTop="10dp" android:visibility="gone"/>
                    <androidx.appcompat.widget.AppCompatButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_start" android:text="@string/ui2_start" android:textSize="17sp" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="52dp" android:minWidth="0dp" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/bg_btn_primary" android:textColor="@color/button_primary_text" android:layout_marginTop="22dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_controls" android:visibility="gone" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_open" android:text="@string/ui2_restart" android:textSize="15sp" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="46dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/action_text" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
                        <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_stop" android:text="@string/ui2_stop" android:textSize="15sp" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="46dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/action_text" android:layout_weight="1" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 常用入口：两枚并排小卡片，去掉分组标题与说明文字 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:id="@+id/launch_models" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:minHeight="84dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:background="?attr/dshaCardBackground" android:foreground="?attr/selectableItemBackground">
                        <ImageView android:layout_width="@dimen/tile_size" android:layout_height="@dimen/tile_size" android:src="@drawable/ic_settings" android:background="@drawable/bg_tile_blue" android:padding="6dp" android:contentDescription="@null" app:tint="@color/tile_on"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui2_models" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/launch_address" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:minHeight="84dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:background="?attr/dshaCardBackground" android:foreground="?attr/selectableItemBackground" android:layout_marginStart="12dp">
                        <ImageView android:layout_width="@dimen/tile_size" android:layout_height="@dimen/tile_size" android:src="@drawable/ic_ui_link" android:background="@drawable/bg_tile_blue" android:padding="6dp" android:contentDescription="@null" app:tint="@color/tile_on"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui2_address" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 运行详情（折叠） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/dshaCardBackground" android:layout_marginTop="12dp">
                    <LinearLayout android:id="@+id/launch_details_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="14dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/apple_launch_details" android:textSize="16sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
                        <ImageView android:id="@+id/launch_details_chevron" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_disclosure" android:contentDescription="@null"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/launch_details_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_selection" android:layout_weight="1" android:padding="14dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_port" android:text="—" android:textSize="20sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_port" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="6dp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_selection" android:layout_weight="1" android:padding="14dp" android:layout_marginStart="10dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_environment" android:text="—" android:textSize="20sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_environment" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="6dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_log_panel" android:orientation="vertical" android:layout_marginTop="14dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui2_logs" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_weight="1"/>
                                <Button android:id="@+id/launch_download_logs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.DSHA.TextButton" android:text="@string/ui_m0046"/>
                            </LinearLayout>
                            <com.deepseekharness.app.ui.LogScrollView android:layout_width="match_parent" android:layout_height="180dp" android:id="@+id/launch_log_scroll" android:fillViewport="true" android:background="@drawable/bg_ui2_console">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/lan_addr" android:text="" android:textSize="12sp" android:textColor="@color/primary" android:includeFontPadding="false" android:visibility="gone" android:textIsSelectable="true"/>
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_log" android:text="@string/ui_m0025" android:textSize="12sp" android:textColor="@color/ui2_log_text" android:includeFontPadding="false" android:fontFamily="monospace" android:textIsSelectable="true" android:padding="12dp"/>
                                </LinearLayout>
                            </com.deepseekharness.app.ui.LogScrollView>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                                <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_safe" android:text="@string/ui_m0007" android:textSize="14sp" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="46dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/action_text" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
                                <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_recovery" android:text="@string/ui_m0011" android:textSize="14sp" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="46dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/action_text" android:layout_weight="1" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/launch_web" android:visibility="gone">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/launch_web_box"/>
    </FrameLayout>
</FrameLayout>
