<?xml version="1.0" encoding="utf-8"?>
<!-- 苹果官网式外壳：细顶栏（小 logo + 中号标题 + 右侧图标），发丝分隔，半透明标签栏。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dshaPageBackground" android:orientation="vertical">
  <LinearLayout android:id="@+id/app_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="10dp" android:background="?attr/dshaBarBackground">
    <FrameLayout android:id="@+id/app_logo" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_ui2_mark">
      <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_terminal" app:tint="@color/mark_on"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/sub_back" android:visibility="gone" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ui_back" android:contentDescription="@string/ui_m0201" app:tint="@color/primary"/>
    <TextView android:id="@+id/app_title" style="@style/DshaText.PageTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_control" android:text="DSHA" android:textSize="17sp" android:textStyle="normal" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.01" android:maxLines="1" android:ellipsize="end"/>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_tasks" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:src="@drawable/ic_ui_tasks" app:tint="@color/text_secondary" android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/btn_theme" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="44dp" android:layout_height="44dp" android:text="@string/ui_m0020" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"/>
    <FrameLayout android:id="@+id/btn_about" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_chip_clickable" android:clickable="true" android:contentDescription="@string/ui_m0067" android:focusable="true" android:visibility="gone">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_about" app:tint="@color/text_secondary"/>
    </FrameLayout>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="@dimen/hairline" android:background="@color/separator"/>
  <TextView android:id="@+id/environment_recovery_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:padding="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp" android:textColor="@color/primary" android:background="@drawable/bg_chip_clickable" android:textSize="14sp" android:clickable="true" android:focusable="true" android:visibility="gone" android:gravity="center" android:includeFontPadding="false"/>
  <FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" style="@style/Widget.DSHA.BottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/dshaBarBackground" android:minHeight="58dp" app:itemIconSize="22dp" app:itemPaddingTop="7dp" app:itemPaddingBottom="5dp" app:elevation="0dp" app:itemIconTint="@color/nav_item_tint" app:itemTextColor="@color/nav_item_tint" app:labelVisibilityMode="labeled" app:menu="@menu/bottom_nav_menu" app:itemTextAppearanceActive="@style/Ui2.Nav" app:itemTextAppearanceInactive="@style/Ui2.Nav"/>
</LinearLayout>
