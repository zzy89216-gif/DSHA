          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_export_sub" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_ui2_chevron" android:contentDescription="@null"/>
