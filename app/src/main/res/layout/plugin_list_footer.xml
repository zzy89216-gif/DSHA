          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_import_sub" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        </LinearLayout>
